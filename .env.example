# Copy to .env (gitignored) and fill in. Values come from your AtScale deployment's Keycloak setup.
ATSCALE_API_URL=http://localhost:3001
ATSCALE_AUTH_URL=http://localhost/auth
ATSCALE_CLIENT_ID=atscale-modeler
ATSCALE_CLIENT_SECRET=
ATSCALE_USERNAME=
ATSCALE_PASSWORD=
# ATSCALE_API_TOKEN is written by scripts/mint_token.sh
